# Required for `mka ingest` and `mka ask`.
OPENAI_API_KEY=
PINECONE_API_KEY=

# Default is ./corpus (not committed). Override if needed:
# CORPUS_DIR=

PINECONE_INDEX=mka-poc
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=poc

LLM_PROVIDER=openai
CHAT_MODEL=gpt-5.4-nano
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

TOP_K=8
RETRIEVE_FLOOR=0.20
MAX_QUERY_CHARS=4000
